{
    "name": "music-streaming-backend",
    "version": "1.0.0",
    "description": "Backend for music streaming platform",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node scripts/dev.js",
        "test": "jest",
        "validate": "node scripts/validate-imports.js",
        "test:load": "node scripts/test-module-loading.js",
        "db:create": "node scripts/create-db.js",
        "db:migrate": "node scripts/migrate.js",
        "db:seed": "node scripts/seed.js",
        "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
        "setup": "npm install && npm run validate && npm run db:setup",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,json,md}\"",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:build": "docker-compose build",
        "docker:setup": "npm run docker:up && npm run db:setup"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.11.3",
        "pg-hstore": "^2.3.4",
        "redis": "^4.6.11",
        "sequelize": "^6.35.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.0",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "private": true,
    "license": "MIT"
}